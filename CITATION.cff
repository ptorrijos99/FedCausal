cff-version: 1.2.0
title: "fedcausal: federated Bayesian network structure learning and causal discovery"
message: "If you use this software, please cite the FedGES paper below, and the FedRCD paper for FedRCD."
type: software
authors:
  - family-names: Torrijos
    given-names: Pablo
    email: pablo.torrijos@uclm.es
    affiliation: "Universidad de Castilla-La Mancha"
    orcid: "https://orcid.org/0000-0002-8395-3848"
  - family-names: Gámez
